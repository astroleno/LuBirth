.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.stage {
  position: relative;
  height: 55vh;
  min-height: 600rpx;
  background: radial-gradient(circle at 50% 45%, #17223a 0, #070b14 68%);
}

.canvas {
  width: 100%;
  height: 100%;
}

.badge {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  max-width: 80%;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  background: rgba(7, 11, 20, 0.78);
  font-size: 22rpx;
}

.badge--pass { color: #7ce5ae; }
.badge--fail { color: #ff7f8d; }
.badge--inconclusive { color: #ffd27c; }
.badge--unsupported { color: #c5a7ff; }

.controls {
  flex: 1;
  box-sizing: border-box;
  padding: 24rpx;
}

.section {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  background: #101725;
}

.eyebrow {
  display: block;
  margin-bottom: 14rpx;
  color: #7f91b5;
  font-size: 20rpx;
  letter-spacing: 3rpx;
}

.select {
  padding: 18rpx;
  border-radius: 12rpx;
  background: #172136;
}

.row {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin-top: 18rpx;
}

.actions {
  display: grid;
  gap: 14rpx;
}

.result {
  display: block;
  min-height: 160rpx;
  color: #b9c6df;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 20rpx;
  white-space: pre-wrap;
  word-break: break-all;
}
