.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.stage {
  position: relative;
  flex: none;
  height: 44vh;
  min-height: 0;
  background: radial-gradient(circle at 50% 45%, #17223a 0, #070b14 68%);
}

.canvas {
  width: 100%;
  height: 100%;
}

.badge {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  max-width: 80%;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  background: rgba(7, 11, 20, 0.78);
  font-size: 22rpx;
}

.badge--pass { color: #7ce5ae; }
.badge--fail { color: #ff7f8d; }
.badge--inconclusive { color: #ffd27c; }
.badge--unsupported { color: #c5a7ff; }

.controls {
  flex: none;
  height: 56vh;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx;
}

.diagnostic-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  gap: 16rpx;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  background: rgba(16, 23, 37, 0.96);
}

.diagnostic-status {
  min-width: 0;
  color: #b9c6df;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.diagnostic-copy {
  flex: none;
  margin: 0;
}

.section {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  background: #101725;
}

.eyebrow {
  display: block;
  margin-bottom: 14rpx;
  color: #7f91b5;
  font-size: 20rpx;
  letter-spacing: 3rpx;
}

.select {
  padding: 18rpx;
  border-radius: 12rpx;
  background: #172136;
}

.row {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin-top: 18rpx;
}

.effect-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.effect-list text {
  padding: 6rpx 12rpx;
  border: 1rpx solid rgba(124, 229, 174, 0.3);
  border-radius: 999rpx;
  color: #7ce5ae;
  font-size: 18rpx;
}

.actions {
  display: grid;
  gap: 14rpx;
}

.result {
  display: block;
  min-height: 160rpx;
  color: #b9c6df;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 20rpx;
  white-space: pre-wrap;
  word-break: break-all;
}
