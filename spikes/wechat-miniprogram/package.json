{
  "name": "@lubirth/wechat-miniprogram-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.config.mjs",
    "build:device": "SPIKE_DEVICE_BUILD=1 SPIKE_RUNTIME_PROFILE=r160 node build.config.mjs",
    "build:device:comparison": "SPIKE_DEVICE_BUILD=1 SPIKE_RUNTIME_PROFILE=both node build.config.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "test:astro": "esbuild test/astro-source.integration.ts --bundle --platform=node --format=esm --outfile=/tmp/lubirth-astro-source.integration.mjs --log-level=error && node --test /tmp/lubirth-astro-source.integration.mjs",
    "verify": "npm run test && npm run test:astro && npm run check && npm run build:device"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "three": "0.160.1",
    "threejs-miniprogram": "0.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/three": "^0.160.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  }
}
